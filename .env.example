# Cole sua chave da API aqui no arquivo .env (NUNCA comite .env)
ANTHROPIC_API_KEY=sk-ant-api03-coloque-sua-chave-aqui

# Opcional: ativar provider alternativo (escolha apenas um)
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
# CLAUDE_CODE_USE_FOUNDRY=1

# ─── Modelos por agente ────────────────────────────────────────────────────────
# Cada agente usa seu modelo específico; CLAUDE_MODEL é o fallback global.
# Prioridade: CLAUDE_MODEL_<AGENTE> → CLAUDE_MODEL → default embutido no código
# claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
CLAUDE_MODEL_REVIEWER=claude-haiku-4-5-20251001   # avaliação textual — haiku suficiente
CLAUDE_MODEL_ANALYST=claude-sonnet-4-6            # análise técnica de código
CLAUDE_MODEL_IMPLEMENTOR=claude-sonnet-4-6        # geração de código completo
# CLAUDE_MODEL=claude-sonnet-4-6                  # override global (substitui todos acima)

# ─── Otimização de tokens/ciclos (Fase 19) ───────────────────────────────────
# Limites por agente para reduzir custo e evitar estouro de contexto.
# Ajuste fino recomendado: começar com defaults e observar métricas reais.

# Reviewer
REVIEWER_MAX_TURNS=10
REVIEWER_MAX_TOKENS_PER_TURN=1536
REVIEWER_MAX_TOKEN_RECOVERIES=3
REVIEWER_MAX_TOTAL_TOKENS=12000
REVIEWER_SOFT_BUDGET_RATIO=0.8
REVIEWER_SOFT_MAX_TOKENS_PER_TURN=900
REVIEWER_SNAPSHOT_INTERVAL=6
REVIEWER_MAX_HISTORY_MESSAGES=24
REVIEWER_ENABLE_PROMPT_COMPACT=0
REVIEWER_PROMPT_MODE=auto
REVIEWER_PROMPT_AUTO_COOLDOWN_TURNS=2
REVIEWER_PROMPT_AUTO_MIN_TURNS_FOR_DEEP=2
REVIEWER_PROMPT_AUTO_DEEP_COMPLEXITY_THRESHOLD=0.62
REVIEWER_PROMPT_AUTO_DEEP_BUDGET_CEILING=0.72
REVIEWER_PROMPT_AUTO_COMPACT_BUDGET_THRESHOLD=0.88
REVIEWER_PROMPT_AUTO_MAX_SWITCHES=4
REVIEWER_ENABLE_SNAPSHOT=1
REVIEWER_ENABLE_CACHE=1
REVIEWER_ENABLE_BUDGET=1

# Analyst
ANALYST_MAX_TURNS=25
ANALYST_MAX_TOKENS_PER_TURN=1536
ANALYST_MAX_TOKEN_RECOVERIES=3
ANALYST_MAX_TOTAL_TOKENS=40000
ANALYST_SOFT_BUDGET_RATIO=0.8
ANALYST_SOFT_MAX_TOKENS_PER_TURN=900
ANALYST_MAX_OUTPUT_CHARS=3000
ANALYST_SNAPSHOT_INTERVAL=6
ANALYST_MAX_HISTORY_MESSAGES=28
ANALYST_ENABLE_PROMPT_COMPACT=0
ANALYST_PROMPT_MODE=auto
ANALYST_PROMPT_AUTO_COOLDOWN_TURNS=2
ANALYST_PROMPT_AUTO_MIN_TURNS_FOR_DEEP=2
ANALYST_PROMPT_AUTO_DEEP_COMPLEXITY_THRESHOLD=0.62
ANALYST_PROMPT_AUTO_DEEP_BUDGET_CEILING=0.72
ANALYST_PROMPT_AUTO_COMPACT_BUDGET_THRESHOLD=0.88
ANALYST_PROMPT_AUTO_MAX_SWITCHES=4
ANALYST_ENABLE_SNAPSHOT=1
ANALYST_ENABLE_CACHE=1
ANALYST_ENABLE_BUDGET=1

# Implementor
IMPLEMENTOR_MAX_TURNS=40
IMPLEMENTOR_MAX_TOKENS_PER_TURN=3072
IMPLEMENTOR_MAX_TOKEN_RECOVERIES=3
IMPLEMENTOR_MAX_TOTAL_TOKENS=70000
IMPLEMENTOR_SOFT_BUDGET_RATIO=0.8
IMPLEMENTOR_SOFT_MAX_TOKENS_PER_TURN=1800
IMPLEMENTOR_MAX_OUTPUT_CHARS=5000
IMPLEMENTOR_SNAPSHOT_INTERVAL=6
IMPLEMENTOR_MAX_HISTORY_MESSAGES=30
IMPLEMENTOR_ENABLE_PROMPT_COMPACT=0
IMPLEMENTOR_PROMPT_MODE=auto
IMPLEMENTOR_PROMPT_AUTO_COOLDOWN_TURNS=2
IMPLEMENTOR_PROMPT_AUTO_MIN_TURNS_FOR_DEEP=2
IMPLEMENTOR_PROMPT_AUTO_DEEP_COMPLEXITY_THRESHOLD=0.62
IMPLEMENTOR_PROMPT_AUTO_DEEP_BUDGET_CEILING=0.72
IMPLEMENTOR_PROMPT_AUTO_COMPACT_BUDGET_THRESHOLD=0.88
IMPLEMENTOR_PROMPT_AUTO_MAX_SWITCHES=4
IMPLEMENTOR_ENABLE_SNAPSHOT=1
IMPLEMENTOR_ENABLE_CACHE=1
IMPLEMENTOR_ENABLE_BUDGET=1

# ─── Retomada por checkpoint (Fase 20) ───────────────────────────────────────
# Save/load no worker + resume funcional controlado por agente.
RESUME_ENABLE_CHECKPOINT_SAVE=1
RESUME_ENABLE_CHECKPOINT_LOAD=1
RESUME_CHECKPOINT_VERSION=1
RESUME_ENABLE_FUNCTIONAL=0
REVIEWER_ENABLE_RESUME=0
ANALYST_ENABLE_RESUME=0
IMPLEMENTOR_ENABLE_RESUME=0
RESUME_ENABLE_REPLAY_SKIP=0
REVIEWER_ENABLE_REPLAY_SKIP=0
ANALYST_ENABLE_REPLAY_SKIP=0
IMPLEMENTOR_ENABLE_REPLAY_SKIP=0
REVIEWER_REPLAY_MAX_CACHED_RESULT_CHARS=12000
ANALYST_REPLAY_MAX_CACHED_RESULT_CHARS=20000
IMPLEMENTOR_REPLAY_MAX_CACHED_RESULT_CHARS=24000
RESUME_ENABLE_QUALITY_GATES=0
REVIEWER_ENABLE_QUALITY_GATES=0
ANALYST_ENABLE_QUALITY_GATES=0
IMPLEMENTOR_ENABLE_QUALITY_GATES=0
REVIEWER_QUALITY_GATE_RISK_THRESHOLD=0.72
ANALYST_QUALITY_GATE_RISK_THRESHOLD=0.72
IMPLEMENTOR_QUALITY_GATE_RISK_THRESHOLD=0.72
RESUME_CHECKPOINT_MIN_COMPAT_VERSION=1
RESUME_CHECKPOINT_MAX_PER_JOB=50
RESUME_CHECKPOINT_MAX_STATE_CHARS=120000
RESUME_CHECKPOINT_MAX_STRING_CHARS=4000
RESUME_CHECKPOINT_MAX_TOOL_PROGRESS=70
RESUME_CHECKPOINT_REDACT_SENSITIVE=1
RESUME_REHYDRATE_TIMEOUT_MS=3000
REVIEWER_REHYDRATE_TIMEOUT_MS=3000
ANALYST_REHYDRATE_TIMEOUT_MS=4000
IMPLEMENTOR_REHYDRATE_TIMEOUT_MS=5000

# ─── Jira MCP (mcp-atlassian) ──────────────────────────────────────────────
# JIRA_URL       : URL da sua instância  ex: https://empresa.atlassian.net
# JIRA_USER_EMAIL: e-mail da conta Atlassian que gerou o token
# JIRA_API_TOKEN : token gerado em https://id.atlassian.com → Segurança → Tokens de API
JIRA_URL=https://sua-empresa.atlassian.net
JIRA_USER_EMAIL=voce@empresa.com
JIRA_API_TOKEN=seu-token-aqui

# ─── Agente Revisor (POP-REQ-001) ──────────────────────────────────────────
# Status que dispara a revisão da história de usuário
JIRA_TRIGGER_STATUS=Em Revisão
# Status após aprovação
JIRA_APPROVED_STATUS=Aprovado
# Status após reprovação
JIRA_REJECTED_STATUS=Rascunho

# ─── Agente Analista Técnico ────────────────────────────────────────────────
# Status que dispara a análise técnica do codebase
JIRA_ANALYST_TRIGGER_STATUS=Em Análise Técnica
# Status após a análise técnica ser publicada (deve ser o trigger do implementor)
JIRA_ANALYST_DONE_STATUS=Pronto para Começar
# ID do campo customizado do Jira onde a spec técnica é salva
# Descubra via: curl -u email:token https://empresa.atlassian.net/rest/api/3/field | jq '.[] | select(.name=="Solução Técnica") | .id'
JIRA_ANALYST_FIELD_ID=customfield_XXXXX
# Caminho do arquivo de configuração de codebases (dentro do container)
CODEBASES_CONFIG=/app/codebases.json
# Modo de mapeamento de codebases: url
CODEBASES_MODE=url
# Raiz local de armazenamento dos repositórios clonados
CODEBASES_ROOT=/workspace/codebases
# Reservado para cache/indice de codebases (uso futuro)
CODEBASES_CACHE_PATH=/tmp/codebases-cache.json
# Lista de hosts Git permitidos para clone automático
CODEBASES_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org,dev.azure.com,ssh.dev.azure.com
# Clone automático: tentativas e timeout
CODEBASE_CLONE_RETRIES=1
CODEBASE_CLONE_TIMEOUT_MS=300000

# ─── Agente Implementador ───────────────────────────────────────────────────
# Status que dispara a implementação automática
JIRA_IMPLEMENTOR_TRIGGER_STATUS=Pronto para Começar
# Status logo ao iniciar (set pelo sistema, antes do loop do agente)
JIRA_IMPLEMENTOR_START_STATUS=Em andamento
# Status após a PR/MR ser criada (set pelo próprio agente ao final)
JIRA_IMPLEMENTOR_DONE_STATUS=Code Review
# Status em caso de erro ou interrupção (set pelo sistema no finally)
# Deixe vazio para apenas logar o erro sem alterar o status
JIRA_IMPLEMENTOR_ERROR_STATUS=Pausado
# Nome e e-mail usados nos commits do agente
GIT_USER_NAME=Agent Bot
GIT_USER_EMAIL=agent@empresa.com

# ─── Autenticação SSH para clone de repositórios ─────────────────────────────
# Solução recomendada para acessar repositórios privados via SSH.
#
# COMO GERAR (fazer uma vez por projeto):
#   # Linux/Mac — passphrase vazia com -N "":
#   ssh-keygen -t ed25519 -C "agent-squad deploy key" -f agent_deploy_key -N ""
#
#   # Windows PowerShell — -N "" não funciona; envie dois Enters via stdin:
#   "`n`n" | ssh-keygen -t ed25519 -C "agent-squad deploy key" -f agent_deploy_key
#   # (pressione Enter duas vezes se ainda pedir confirmação)
#
#   # Isso gera: agent_deploy_key (privada) e agent_deploy_key.pub (pública)
#
#   # Encode a chave privada em base64 (numa linha só):
#   # Linux/Mac:
#   cat agent_deploy_key | base64 -w 0
#   # Windows PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("agent_deploy_key"))
#
#   # Adicione o conteúdo de agent_deploy_key.pub como Deploy Key em cada repo:
#   # GitHub  → Settings → Deploy keys → Add deploy key (somente leitura para clone)
#   # GitLab  → Settings → Repository → Deploy keys
#   # Bitbucket → Repository settings → Access keys
#
#   # Apague os arquivos locais — só o base64 vai para o .env:
#   del agent_deploy_key agent_deploy_key.pub  (Windows)
#   rm agent_deploy_key agent_deploy_key.pub   (Linux/Mac)
#
# Cole aqui o resultado do base64 (tudo em uma linha):
# GIT_SSH_KEY_B64=

# ─── Provedor Git ─────────────────────────────────────────────────────────────
# Escolha o provedor: github | gitlab | bitbucket | azure
GIT_PROVIDER=gitlab

# GitHub — Personal Access Token com permissão repo + pull_requests:write
# GH_TOKEN=ghp_seu-token-aqui
# Para GitHub Enterprise Server, defina também:
# GITHUB_API_URL=https://github.empresa.com/api/v3

# GitLab — Personal Access Token com escopo api
# GITLAB_TOKEN=glpat-seu-token-aqui
# Para GitLab self-hosted, defina também:
# GITLAB_URL=https://gitlab.empresa.com

# Bitbucket Cloud — App Password para operações git HTTPS (push/fetch/clone)
# Crie em: bitbucket.org → Configurações de conta → App passwords
# Permissões necessárias: Repositories → Read + Write
# Atenção: JIRA_API_TOKEN é um Atlassian API Token — funciona para a REST API
# mas NÃO para autenticação git HTTPS no Bitbucket Cloud.
BITBUCKET_APP_PASSWORD=seu-app-password-aqui
# Para Bitbucket Server/Data Center, defina também:
# BITBUCKET_URL=https://bitbucket.empresa.com

# Azure DevOps — Personal Access Token com escopo Code (Read & Write)
# AZURE_DEVOPS_PAT=seu-pat-aqui
# Opcional: versão da API REST (default: 7.1)
# AZURE_DEVOPS_API_VERSION=7.1

# Porta do servidor de webhook (Jira envia POST aqui)
WEBHOOK_PORT=3000
# Segurança do webhook
# 1 para exigir validação de assinatura HMAC SHA256
WEBHOOK_SIGNATURE_REQUIRED=0
# Header com a assinatura recebida
JIRA_WEBHOOK_SIGNATURE_HEADER=x-hub-signature
# Segredo compartilhado para validar assinatura
JIRA_WEBHOOK_SECRET=

# MySQL — usado pelo docker-compose e pela camada de logging
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=agent_squad
MYSQL_USER=agent
MYSQL_PASSWORD=agentpassword
