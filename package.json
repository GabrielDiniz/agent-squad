{
  "name": "claude-agent-squad",
  "version": "0.1.0",
  "private": true,
  "description": "Squad de agentes Claude integrando Jira e código-fonte",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
